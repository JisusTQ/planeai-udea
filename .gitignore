*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# ----- Variables de entorno (¡NUNCA subir secretos/API keys!) -----
.env
*.env
!.env.example

# ----- Node / Frontend -----
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ----- Editores / Sistema operativo -----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ----- Logs y temporales -----
*.log
logs/
