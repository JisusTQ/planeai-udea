# ============================================================
#  Variables de entorno de PlaneAI UdeA (Backend)
#
#  1. Copia este archivo como ".env"  ->  copy .env.example .env
#     (¡COPIAR, no renombrar! Así conservas esta plantilla.)
#  2. Completa los valores reales.
#  3. El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# ============================================================

# --- Base de datos PostgreSQL (Neon) ---
# Pega aquí TU cadena de conexión real de Neon (Dashboard -> Connection string).
# Formato: postgresql://usuario:password@host/basedatos?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/planeai?sslmode=require

# --- Google Gemini ---
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# --- Configuracion de la aplicacion ---
APP_NAME=PlaneAI UdeA
APP_ENV=development

# Origenes permitidos para CORS (frontend), separados por coma
CORS_ORIGINS=http://localhost:5173
